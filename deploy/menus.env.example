# Menus service — menu discovery, scraping, AI parsing, image storage.
# Copy to menus.env in $STASHH_ENV_DIR and fill in values.

SUPABASE_URL=https://wnkjvfpaikowayuicnqk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

OPENROUTER_API_KEY=

# Comma-separated Bearer tokens accepted on /internal/v1/* endpoints.
# The backend sends MENU_SERVICE_TOKEN, which must be one of these.
# Each token must be >= 32 characters.
INTERNAL_API_TOKENS=

# Optional: Brave Search API key for Google-free menu URL discovery
BRAVE_SEARCH_API_KEY=

# Worker settings (defaults shown)
# MENU_WORKER_CONCURRENCY=2
# IMAGE_MAX_WIDTH=800
