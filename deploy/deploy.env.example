# Settings of the auto-deploy (deploy/update.sh), loaded from the host's deploy.env:
# ~/HomeServer/stashh/env on home-server, /srv/stashh/env on a Linux host (deploy/install.sh,
# whose paths the values below use). Copy, then edit.

# Branch the host follows; a push to it is live within a minute.
STASHH_BRANCH=develop
# The checkout the timer deploys from and the env files it reads (never inside the checkout).
STASHH_REPO_DIR=/srv/stashh/repo
STASHH_ENV_DIR=/srv/stashh/env
