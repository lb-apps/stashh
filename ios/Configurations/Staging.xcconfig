// Staging.xcconfig
// Daily development build.
// Runtime values (URLs, keys, credentials) live in ios/Config/Staging.plist — NOT here.

#include "Base.xcconfig"

// Swift — previews / Canvas require unoptimized builds (-Onone), not -O.
SWIFT_OPTIMIZATION_LEVEL = -Onone

// Build flags
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG STAGING
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 STAGING=1 $(inherited)
ENABLE_TESTABILITY = YES

// App identity
APP_DISPLAY_NAME = Stashh (Staging)
BUNDLE_ID_SUFFIX = .staging
