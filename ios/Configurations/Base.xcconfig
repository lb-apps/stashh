// Base.xcconfig
// Shared build settings for all configurations.
// Environment-specific xcconfigs include this file.

// Team
DEVELOPMENT_TEAM = MF6BPKJTF8

// Swift
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

// Info.plist
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Stashh/Info.plist

// Product
PRODUCT_BUNDLE_IDENTIFIER = com.emirhanerdogan.Stashh$(BUNDLE_ID_SUFFIX)
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Linker
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// Assets
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES

// Capabilities
ENABLE_PREVIEWS = YES
CODE_SIGN_STYLE = Automatic
TARGETED_DEVICE_FAMILY = 1,2
