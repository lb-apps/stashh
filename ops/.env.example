# Copy to .env.local (gitignored). The dashboard runs only on 127.0.0.1:3003.

# Backend internal API. The token is one of backend INTERNAL_API_TOKENS — give the
# dashboard its own entry so it can be revoked on its own.
STASHH_API_URL=http://localhost:3000
STASHH_OPS_TOKEN=

# Instagram channel. The token is one of instagram OPS_API_TOKENS.
INSTAGRAM_API_URL=http://localhost:3002
INSTAGRAM_OPS_TOKEN=
