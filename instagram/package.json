{
  "name": "stashh-instagram",
  "version": "0.1.0",
  "description": "Stashh Instagram DM channel — receives Messaging webhooks, drives recognitions on the Stashh API, replies in the thread",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/start.ts",
    "start": "node src/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
