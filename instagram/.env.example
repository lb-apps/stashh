# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Meta App Dashboard → Instagram → API setup with Instagram login → Instagram app secret.
# Signs every webhook delivery (X-Hub-Signature-256).
INSTAGRAM_APP_SECRET=

# Any random string ≥ 16 chars; the same value goes into the dashboard's webhook "Verify token".
# Generate: openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=

# The hooks relay (hooks.stashh.me, docs/webhook-relay.md): the same value as the Worker's
# HOOKS_RELAY_SECRET, in production and on the dev Mac. Unset → the relay's probe is refused
# (nobody is routed here) and relayed deliveries get 403; Meta's direct deliveries still work.
# Generate once: openssl rand -hex 32
HOOKS_RELAY_SECRET=

# Outside production (NODE_ENV ≠ production) only: whom this instance may write to.
# routed (default) — only senders the relay routed here with /env dev
# live — anyone; only for testing with Meta's callback pointed straight at the dev tunnel
# off — no one. An unknown value means off. Production always writes.
# META_OUTBOUND=routed

# Development only: also write every verified delivery here to build test fixtures.
WEBHOOK_CAPTURE_DIR=.captures

# The Instagram professional account this service answers for (webhook entry id / IG user_id).
INSTAGRAM_ACCOUNT_ID=

# First run only: seeds instagram_accounts; the service refreshes the token itself from then on.
# Meta App Dashboard → Instagram → API setup with Instagram login → Generate access tokens.
INSTAGRAM_ACCESS_TOKEN=

# GRAPH_API_VERSION=v26.0
# WORKER_CONCURRENCY=4

# Stashh backend internal API. The token is one of the backend's INTERNAL_API_TOKENS.
STASHH_API_URL=http://localhost:3000
STASHH_API_TOKEN=

# Same Supabase project as the backend; the channel's tables are service-role only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Local ops dashboard (ops/): bearer tokens for GET /ops/stats, comma-separated, each ≥ 32 chars.
# Unset → the route does not exist. Generate: openssl rand -hex 32
OPS_API_TOKENS=

# Quick replies under a finished recognition ("Listeye koy", "Haritamı aç"); off, people write what they want.
# RECOGNITION_SUGGESTED_REPLIES=off

# Mixpanel project token for the conversation's product events (docs/analytics-plan.md).
# Here: "Stashh - Staging". On the production host (instagram.env): "Stashh - Production".
# Empty → no events.
MIXPANEL_TOKEN=
