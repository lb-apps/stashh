# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Meta App Dashboard → Instagram → API setup with Instagram login → Instagram app secret.
# Signs every webhook delivery (X-Hub-Signature-256).
INSTAGRAM_APP_SECRET=

# Any random string ≥ 16 chars; the same value goes into the dashboard's webhook "Verify token".
# Generate: openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=

# Development only: also write every verified delivery here to build test fixtures.
WEBHOOK_CAPTURE_DIR=.captures

# The Instagram professional account this service answers for (webhook entry id / IG user_id).
INSTAGRAM_ACCOUNT_ID=

# First run only: seeds instagram_accounts; the service refreshes the token itself from then on.
# Meta App Dashboard → Instagram → API setup with Instagram login → Generate access tokens.
INSTAGRAM_ACCESS_TOKEN=

# GRAPH_API_VERSION=v26.0
# WORKER_CONCURRENCY=4

# Stashh backend internal API. The token is one of the backend's INTERNAL_API_TOKENS.
STASHH_API_URL=http://localhost:3000
STASHH_API_TOKEN=

# Same Supabase project as the backend; the channel's tables are service-role only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Local ops dashboard (ops/): bearer tokens for GET /ops/stats, comma-separated, each ≥ 32 chars.
# Unset → the route does not exist. Generate: openssl rand -hex 32
OPS_API_TOKENS=
