# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Meta App Dashboard → Instagram → API setup with Instagram login → Instagram app secret.
# Signs every webhook delivery (X-Hub-Signature-256).
INSTAGRAM_APP_SECRET=

# Any random string ≥ 16 chars; the same value goes into the dashboard's webhook "Verify token".
# Generate: openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=

# Development only: write every verified delivery here to build test fixtures.
WEBHOOK_CAPTURE_DIR=.captures
