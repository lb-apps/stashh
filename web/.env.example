# Stashh web — copy to .env.local and fill in. NEXT_PUBLIC_* values ship to the browser.

# The Stashh API the browser calls directly (its CORS allowlist must include this site).
NEXT_PUBLIC_STASHH_API_URL=http://localhost:3000
# Same Supabase project as the backend. The publishable key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Mapbox public token (pk.…), URL-restricted to stashh.me and localhost in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Mixpanel project token (public by design). Local and Vercel previews use "Stashh - Staging",
# production "Stashh - Production"; empty turns analytics off. APP_ENV is `production` on stashh.me only.
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_APP_ENV=development
# Meta Pixel (dataset) id, public by design. Set in Vercel production only; empty sends nothing to
# Meta, from the browser or the server.
NEXT_PUBLIC_META_PIXEL_ID=

# Server only. The backend's internal API, used to redeem DM sign-in links.
# STASHH_INTERNAL_TOKEN is one of the backend's INTERNAL_API_TOKENS.
STASHH_API_URL=http://localhost:3000
STASHH_INTERNAL_TOKEN=
# Meta Conversions API token for that dataset (Events Manager > Settings > Conversions API).
# META_TEST_EVENT_CODE is for local and preview only: events then land under Test Events.
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Development only: /app/dev signs in as the backend's test user. Ignored in production.
DEV_TEST_EMAIL=
DEV_TEST_PASSWORD=
