{
  "name": "stashh-backend",
  "version": "0.1.0",
  "description": "Stashh — Instagram place recognition API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/modules/recognitions/worker.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:types": "sh -c 'supabase gen types typescript --project-id \"${SUPABASE_PROJECT_REF}\" --schema public > src/types/database.ts'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@scalar/express-api-reference": "^0.8.48",
    "@supabase/supabase-js": "^2.102.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "btch-downloader": "^6.3.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.2.0",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
