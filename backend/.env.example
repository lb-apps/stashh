GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
APIHUT_API_KEY=your_apihut_api_key_here
PORT=3000
TEMP_DIR=/tmp/stashh

# Supabase — Project Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co
# Optional: direct Postgres URL for LISTEN/NOTIFY worker wakeups (recommended)
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Publishable key (sb_publishable_...). Preferred.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon key — same header use as publishable during migration (optional if publishable set).
# SUPABASE_ANON_KEY=

# Server-only elevated key (sb_secret_...). Bypasses RLS — never ship to clients.
# SUPABASE_SECRET_KEY=

# Dev-only: GET /dev/token uses password grant (not for production).
DEV_TEST_EMAIL=test@example.com
DEV_TEST_PASSWORD=your-test-password

# Recognition worker runtime
RECOGNITIONS_WORKER_CONCURRENCY=2
RECOGNITIONS_CLAIM_BATCH_SIZE=2
RECOGNITIONS_MAX_RETRIES=3
RECOGNITIONS_POLL_MIN_MS=1500
RECOGNITIONS_POLL_MAX_MS=5000
RECOGNITIONS_CLAIM_TIMEOUT_MS=900000
RECOGNITIONS_RECOVERY_SCAN_INTERVAL_MS=30000
# Set true locally to skip recognition_results URL cache (always re-run Gemini; use when debugging prompts).
# RECOGNITIONS_BYPASS_RESULT_CACHE=true
PLACE_THUMBNAILS_BUCKET=place-thumbnails

# Regenerate DB types: export SUPABASE_PROJECT_REF=<ref> && npm run db:types (Supabase CLI installed)

# Internal API (/internal/v1) for trusted channel adapters (the Instagram DM service).
# Comma-separated bearer tokens, each ≥ 32 chars; list two during a rotation. Unset → disabled.
# Generate: openssl rand -hex 32
# INTERNAL_API_TOKENS=
# Reserved, never-mailed domain for channel-identity users (Supabase Auth needs an email).
# CHANNEL_IDENTITY_EMAIL_DOMAIN=identities.stashh.me
