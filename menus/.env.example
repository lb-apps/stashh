PORT=3004
LOG_LEVEL=info

# Supabase (service-role: menu tables are not public)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — AI menu parsing and verification
OPENROUTER_API_KEY=

# Google Custom Search — menu discovery via Google search
# Same API key as backend (enable Custom Search API); create a
# Programmable Search Engine at programmablesearchengine.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Bearer tokens the backend sends (comma-separated, each ≥ 32 chars)
INTERNAL_API_TOKENS=

# Worker
MENU_WORKER_CONCURRENCY=2

# Image processing
IMAGE_MAX_WIDTH=800
